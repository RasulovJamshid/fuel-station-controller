# ════════════════════════════════════════════════════════════════════════════
#  AZS Manager — Backend Environment Variables
#  Copy to .env and fill in before deploying.
#  Generate secrets: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
# connection_limit: max connections per process (CPU_cores * 2 is a good start)
# pool_timeout: seconds to wait for a free connection before erroring
DATABASE_URL=postgresql://azs:CHANGE_ME@postgres:5432/azs_manager?connection_limit=10&pool_timeout=30
POSTGRES_DB=azs_manager
POSTGRES_USER=azs
POSTGRES_PASSWORD=CHANGE_ME

# Optional. Keep false unless prisma/timescale.sql has been validated against
# the current Prisma primary keys and indexes on the target database.
ENABLE_TIMESCALE_SETUP=false

# ── Redis ─────────────────────────────────────────────────────────────────────
# Password must match REDIS_PASSWORD — both are required
REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_PASSWORD=CHANGE_ME

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_64_CHAR_HEX
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_HEX_DIFFERENT
JWT_REFRESH_EXPIRES_IN=30d

# ── Auth hardening ────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed HTTP origins (used for API + WebSocket).
CORS_ORIGINS=https://fuelstation.ung.uz

# ── Swagger ───────────────────────────────────────────────────────────────────
# Disabled in production by default — enable only for internal debugging.
SWAGGER_ENABLED=false

# ── Notifications ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# ── Alerting ──────────────────────────────────────────────────────────────────
SYNC_LAG_ALERT_MINUTES=30

# ── Data retention (days; set to 0 to disable purge) ─────────────────────────
TRANSACTION_RETENTION_DAYS=1825
ATG_READINGS_RAW_RETENTION_DAYS=90
HEALTH_EVENTS_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_CRON=0 2 * * *
BACKUP_PATH=/backups
BACKUP_S3_BUCKET=

# ── Superadmin seed ──────────────────────────────────────────────────────────
# The seed is idempotent. You may remove SEED_ADMIN_PASSWORD after first login.
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
